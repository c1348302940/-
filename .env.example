# Browser-safe project values
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Never expose this value in public/ or commit it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional direct connection used by migration tooling only.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@host:6543/postgres

APP_ORIGIN=http://127.0.0.1:8787

# Login usernames are converted internally to:
# <normalized-username>@users.tianyu.invalid
